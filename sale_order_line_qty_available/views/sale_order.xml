<?xml version="1.0" ?>
<odoo>
  <record id="view_order_form_qty_available" model="ir.ui.view">
    <field name="name">sale.order.form.qty.available</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="model">sale.order</field>
    <field name="arch" type="xml">
      <xpath expr="//list/field[@name='product_uom_qty']" position="after">
        <field name="product_qty_available" optional="hide" />
      </xpath>
    </field>
  </record>

  <record id="view_order_line_tree" model="ir.ui.view">
    <field name="name">sale.order.line.tree.available.qty</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale.view_order_line_tree" />
    <field name="arch" type="xml">
      <field name="salesman_id" position="after">
        <field name="product_qty_available" optional="show" />
      </field>
    </field>
  </record>
</odoo>
