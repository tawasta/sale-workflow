<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="view_order_form" model="ir.ui.view">
		<field name="name">sale.order.form.enable.order.name.edit</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form" />
		<field name="arch" type="xml">
            <xpath
                expr="//div[@class='oe_title']//h1//field[@name='name']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >state in ['cancel', 'sent', 'sale']</attribute>
		    </xpath>
		</field>
	</record>
</odoo>
