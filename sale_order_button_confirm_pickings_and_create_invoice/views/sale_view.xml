<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.create.and.confirm.picking.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button
                    name="validate_pickings_then_create_and_post_invoice"
                    string="Confirm Sale, invoice and picking"
                    type="object"
                    invisible="state in ['cancel', 'sale']"
                    class="oe_highlight"
                />
            </xpath>
        </field>
    </record>
</odoo>
