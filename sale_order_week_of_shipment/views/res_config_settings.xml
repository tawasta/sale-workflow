<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.week.of.shipment.additional.weeks</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100" />
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="delivery" position="before">
                <setting
                    id="week_of_shipment_additional_weeks"
                    help="Number of weeks to be added to today's week"
                >
                    <field name="week_of_shipment_additional_weeks" />
                </setting>

                <setting
                    id="week_of_shipment_additional_weeks_group"
                    help="Group to apply the additional weeks rules to"
                >
                    <field name="week_of_shipment_additional_weeks_group" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
