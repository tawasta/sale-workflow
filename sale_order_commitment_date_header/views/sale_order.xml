<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.reposition.commitment.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <xpath expr="//label[@for='commitment_date']" position="move" />
                <xpath expr="//div[field[@name='commitment_date']]" position="move" />
                <xpath
                    expr="//group[@name='sale_shipping']/field[@name='effective_date']"
                    position="move"
                />
            </xpath>
        </field>
    </record>
</odoo>
