<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_tree_inherit_addresses" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.so.addresses</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_invoice_id" optional="show" />
                <field name="partner_shipping_id" optional="show" />
            </field>
        </field>
    </record>
    <record id="view_quotation_tree_inherit_addresses" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.quotation.addresses</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="partner_invoice_id" optional="show" />
                <field name="partner_shipping_id" optional="show" />
            </field>
        </field>
    </record>
</odoo>
