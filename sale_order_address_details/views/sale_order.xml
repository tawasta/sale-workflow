<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.show.addresses.details</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <label
                    for="partner_street"
                    string=" "
                    class="oe_edit_only"
                    invisible="not partner_id"
                />
                <div
                    class="oe_edit_only o_row"
                    id="partner-street-div"
                    style="padding-right: 35px; margin-top: -10px;"
                    invisible="not partner_id"
                >
                    <field
                        name="partner_street"
                        placeholder="Street"
                        readonly="not partner_id"
                    />
                    <field
                        name="partner_street2"
                        placeholder="Street specifier"
                        readonly="not partner_id"
                    />
                </div>

                <label
                    for="partner_zip"
                    string=" "
                    class="oe_edit_only"
                    invisible="not partner_id"
                />
                <span
                    class="o_row oe_edit_only"
                    id="partner-zip-div"
                    style="padding-right: 35px; margin-top: -20px;"
                    invisible="not partner_id"
                >
                    <field
                        name="partner_zip"
                        placeholder="Zip"
                        readonly="not partner_id"
                    />
                    <field
                        name="partner_city"
                        placeholder="City"
                        readonly="not partner_id"
                    />
                </span>

                <div
                    style="padding-right: 35px; margin-top: -10px; display: none;"
                    invisible="not partner_id"
                >
                    <label
                        for="partner_country_id"
                        string=" "
                        class="oe_edit_only"
                        style="padding-right: 35px; margin-top: -10px; display: none;"
                    />
                </div>

                <span
                    class="o_row oe_edit_only"
                    id="partner-country-div"
                    style="padding-right: 0px; margin-top: -30px; width: 105% !important;"
                    invisible="not partner_id"
                >
                    <field name="partner_country_id" readonly="not partner_id" />
                </span>
            </field>

            <field name="partner_id" position="attributes">
                <attribute
                    name="context"
                >{'res_partner_search_mode': 'customer', 'show_address': False, 'show_vat': True}</attribute>
                <attribute name="style">margin-top: -10px;</attribute>
            </field>
        </field>
    </record>
</odoo>
