<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="sale_order_kiosk_message_message_wizard" model="ir.ui.view">
    <field name="name">sale.order.kiosk.message.form</field>
    <field name="model">sale.order.kiosk.message</field>
    <field name="arch" type="xml">
      <form id="kiosk_sale_message_form" create="0" edit="0" delete="0">
        <div id="message">
          <field name="message" readonly="1" />
        </div>
        <footer>
          <button name="action_close" type="object" string="OK" class="oe_highlight" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
