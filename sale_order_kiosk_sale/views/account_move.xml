<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_move_form" model="ir.ui.view">
    <field name="name">account.move.form.print.receipt</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_print_pdf'][2]" position="after">
        <button
          name="print_receipt"
          type="object"
          invisible="state != 'posted' or move_type in ('in_invoice','in_refund','in_receipt')"
          string="Print Receipt"
        />
      </xpath>
    </field>
  </record>
</odoo>
