<?xml version="1.0" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.multicompany</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='product_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <record
        id="view_partner_form_company_id_editable_for_shared_parent"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.partner.form.company_id.editable.for.shared.parent</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='misc']/field[@name='company_id']"
                position="before"
            >
                <field name="parent_company_id" invisible="1" />
            </xpath>
            <xpath
                expr="//group[@name='misc']/field[@name='company_id']"
                position="attributes"
            >
                <attribute name="readonly">parent_id and parent_company_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
