<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_normal_form_view_invoice_company" model="ir.ui.view">
        <field name="name">product.product.form.invoice.company</field>
        <field name="model">product.product</field>
        <field
            name="inherit_id"
            ref="product_variant_variant_company.product_normal_form_view_variant_company"
        />
