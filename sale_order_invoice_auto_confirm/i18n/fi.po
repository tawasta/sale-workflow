#. module: sale_order_invoice_auto_confirm
#: model_terms:ir.ui.view,arch_db:sale_order_invoice_auto_confirm.view_order_form_auto_confirm
msgid ""
"<span class=\"fa fa-bolt me-2 text-primary\" title=\"Lightning bolt\"/>\n"
"                    <strong>Auto-confirm enabled:</strong>\n"
"                    All products in this sale are marked as <em>auto-"
"invoicable</em>.\n"
"                    The invoice will be confirmed automatically after creation."
msgstr ""
"<span class=\"fa fa-bolt me-2 text-primary\" title=\"Lightning bolt\"/>&#13;\n"
"                    <strong>Automaattinen vahvistus käytössä:</strong>  \n"
"                    Kaikki tämän tilauksen tuotteet on merkitty "
"<em>automaattisesti laskutettaviksi</em>.  \n"
"                    Lasku vahvistetaan automaattisesti luomisen jälkeen."

#. module: sale_order_invoice_auto_confirm
#: model_terms:ir.ui.view,arch_db:sale_order_invoice_auto_confirm.view_order_form_auto_confirm
msgid "Are you sure you want to disable auto-confirm for this sale order?"
msgstr ""
"Haluatko varmasti poistaa automaattisen vahvistuksen käytöstä tältä "
"myyntitilaukselta?"

#. module: sale_order_invoice_auto_confirm
#: model:ir.model.fields,field_description:sale_order_invoice_auto_confirm.field_sale_order__auto_confirm_invoice
msgid "Auto Confirm Invoices"
msgstr "Vahvista laskut automaattisesti"

#. module: sale_order_invoice_auto_confirm
#: model_terms:ir.ui.view,arch_db:sale_order_invoice_auto_confirm.view_order_form_auto_confirm
msgid "Disable"
msgstr "Poista käytöstä"

#. module: sale_order_invoice_auto_confirm
#: model:ir.model.fields,help:sale_order_invoice_auto_confirm.field_product_product__auto_confirm_sale_invoice
#: model:ir.model.fields,help:sale_order_invoice_auto_confirm.field_product_template__auto_confirm_sale_invoice
msgid ""
"If checked, sale invoices containing only products with this flag will be auto-"
"confirmed."
msgstr ""
"Myyntilaskut, jotka sisältävät vain tällaisia tuotteita, vahvistetaan "
"automaattisesti."

#. module: sale_order_invoice_auto_confirm
#: model:ir.model.fields,field_description:sale_order_invoice_auto_confirm.field_product_product__auto_confirm_sale_invoice
#: model:ir.model.fields,field_description:sale_order_invoice_auto_confirm.field_product_template__auto_confirm_sale_invoice
msgid "Invoice Auto Confirm"
msgstr "Laskun automaattinen vahvistus"

#. module: sale_order_invoice_auto_confirm
#: model:ir.model,name:sale_order_invoice_auto_confirm.model_product_template
msgid "Product"
msgstr "Tuote"

#. module: sale_order_invoice_auto_confirm
#: model:ir.model,name:sale_order_invoice_auto_confirm.model_sale_advance_payment_inv
msgid "Sales Advance Payment Invoice"
