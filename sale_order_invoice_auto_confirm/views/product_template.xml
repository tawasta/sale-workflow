<?xml version="1.0" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.auto.confirm.invoice</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <group name="sale" position="inside">
                <group name="auto_confirm">
                    <field name="auto_confirm_sale_invoice" widget="boolean_toggle" />
                </group>
            </group>
        </field>
    </record>

    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.tree.auto.confirm.invoice</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="auto_confirm_sale_invoice" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
