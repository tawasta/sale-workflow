<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="force_invoiced_multiple_wizard_form" model="ir.ui.view">
        <field name="model">sale.order.mass.force.invoiced</field>
        <field name="arch" type="xml">
            <form string="Force to be invoiced">
                <p>The selected sale orders will be set as invoiced</p>
                <separator />
                <field name="order_ids" widget="many2many_tags" readonly="1" />
                <separator />
                <footer>
                    <button
                        string="Force invoiced"
                        type="object"
                        class="oe_highlight"
                        name="force_invoiced"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_force_invoiced_multiple" model="ir.actions.act_window">
        <field name="name">Force sale orders to be invoiced</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.mass.force.invoiced</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
    </record>
</odoo>
