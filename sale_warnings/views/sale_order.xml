<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="sale_form_view" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.sale.warning</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="partner_sale_warn_level" invisible="1" />
      </field>
      <!-- Use the core banner at the top of the form. A blocking warning
           is shown only as the error when saving. -->
      <xpath
        expr="//field[@name='sale_warning_text']/parent::div"
        position="attributes"
      >
        <attribute
          name="invisible"
        >not sale_warning_text or partner_sale_warn_level == 'blocking_warning'</attribute>
      </xpath>
    </field>
  </record>
</odoo>
