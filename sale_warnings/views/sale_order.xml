<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="sale_form_view" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.sale.warning</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="partner_sale_warn_level" invisible="1" />
        <group>
          <div
            class="alert alert-warning col-12"
            role="alert"
            invisible="not sale_warning_text or (partner_sale_warn_level not in ('warning', 'popup_warning'))"
          >
            <field name="sale_warning_text" class="fw-bold" />
          </div>
        </group>
      </field>
      <!--       <field name="partner_id" position="attributes"> -->
      <!--         <attribute name="widget">Many2OneWarn</attribute> -->
      <!--       </field> -->
      <xpath expr="//div[@invisible='not sale_warning_text']" position="attributes">
        <attribute name="style">display: none;</attribute>
      </xpath>
    </field>
  </record>
</odoo>
